<Window x:Class="RTSPCameraConfigurator.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About RTSP Camera Setup"
        Width="600" SizeToContent="Height" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,20,24,16">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <TextBlock Text="SPS Automation" Foreground="#999" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Close" IsDefault="True" IsCancel="True" MinWidth="90" Padding="12,5"/>
        </StackPanel>

        <StackPanel>
            <!-- The dark logo variant: this dialog is light, and the supplied asset
                 is white-on-transparent. -->
            <Image Source="/assets/sps-logo.png" Height="64"
                   HorizontalAlignment="Left" Margin="0,0,0,18"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Text="RTSP Camera Setup" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Foreground="#666" Margin="0,2,0,0"/>

            <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#333"
                       Text="Configures OEM RTSP cameras without going through their web GUI. Finds cameras on the watched subnets, connects on a click, and edits imaging, encoder, detection, OSD, network and service settings from a live preview."/>

            <TextBlock Text="Where things are kept" Style="{StaticResource Head}"/>
            <Grid x:Name="PathsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <TextBlock Text="Open source components" Style="{StaticResource Head}"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555">
                <Run Text="Two third-party components are bundled, each run or loaded separately and covered by its own licence:"/>
                <LineBreak/><LineBreak/>
                <Run Text="ffmpeg" FontWeight="SemiBold"/>
                <Run Text=" — the preview decoder, run as a separate process. GPL v3; see ffmpeg-LICENSE.txt beside the executable."/>
                <LineBreak/>
                <Run Text="LibVLC / LibVLCSharp" FontWeight="SemiBold"/>
                <Run Text=" — the fallback preview engine. LGPL v2.1."/>
            </TextBlock>

            <TextBlock Text="Source" Style="{StaticResource Head}"/>
            <TextBlock>
                <Hyperlink NavigateUri="https://github.com/Aeronavics/RTSPCameraConfigurator"
                           RequestNavigate="OnLinkClicked">
                    github.com/Aeronavics/RTSPCameraConfigurator
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </DockPanel>
</Window>
