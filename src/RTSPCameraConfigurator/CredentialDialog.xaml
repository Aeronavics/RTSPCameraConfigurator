<Window x:Class="RTSPCameraConfigurator.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to camera"
        Width="420" SizeToContent="Height" MinHeight="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Auto, not star: the window sizes to content, so a star row would
                 collapse to nothing and clip the buttons. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="PromptText"
                   TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Enter credentials for this camera."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="UserBox" Margin="0,0,0,8"
                   Padding="4,3" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PassBox" Margin="0,0,0,8"
                     Padding="4,3" VerticalContentAlignment="Center"/>

        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="SaveCheck" IsChecked="True"
                  Content="Remember these credentials for this camera" Margin="0,4,0,0"/>

        <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Foreground="#777"
                   FontSize="11" Margin="0,6,0,0"
                   Text="Saved passwords are encrypted for your Windows account only."/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="Connect" IsDefault="True" Click="OnOk"
                    MinWidth="90" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Padding="12,5"/>
        </StackPanel>
    </Grid>
</Window>
