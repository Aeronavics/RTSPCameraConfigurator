<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RTSPCameraConfigurator</AssemblyName>
    <RootNamespace>RTSPCameraConfigurator</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>RTSP Camera Setup</Product>
    <AssemblyTitle>RTSP Camera Setup</AssemblyTitle>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
    <Company>SPS Automation</Company>
    <Description>Configures OEM RTSP cameras without their web GUI.</Description>
    <Copyright>SPS Automation</Copyright>
    <!-- Shown on the About tab and used to name the installer, so bump it here
         and both follow. -->
    <Version>1.7.1</Version>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Deliberately NOT PublishSingleFile: the app locates ffmpeg.exe beside
         itself, and the single-file bundler extracts to a temp directory where
         that lookup no longer finds it. Ship the publish folder. -->
    <PublishSingleFile>false</PublishSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>



  <ItemGroup>
    <None Update="cameras.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Shipped presets. PreserveNewest so a preset edited in the deployed folder is
         not overwritten by a rebuild. -->
    <None Update="presets\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\sps-logo.png" />
  </ItemGroup>

  <!-- ffmpeg is the only preview engine, so a publish that does not carry it is
       not usable. Located at build time rather than committed: it is ~97 MB.
       A missing one is a warning, not an error - a plain build still runs for
       development, it just has no preview. -->
  <Target Name="BundleFfmpeg" AfterTargets="Publish">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\..\tools\find-ffmpeg.cmd&quot;"
          ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="FoundFfmpeg" />
    </Exec>

    <Copy SourceFiles="$(FoundFfmpeg)" DestinationFolder="$(PublishDir)"
          Condition="'$(FoundFfmpeg)' != '' And Exists('$(FoundFfmpeg)')" />

    <!-- The build shipped is GPL v3, so its licence text has to travel with the
         binary. It sits one level up from bin/. -->
    <PropertyGroup Condition="'$(FoundFfmpeg)' != ''">
      <FfmpegRoot>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName($(FoundFfmpeg)))))</FfmpegRoot>
    </PropertyGroup>

    <Copy SourceFiles="$(FfmpegRoot)\LICENSE" DestinationFiles="$(PublishDir)ffmpeg-LICENSE.txt"
          Condition="'$(FfmpegRoot)' != '' And Exists('$(FfmpegRoot)\LICENSE')" />
    <Copy SourceFiles="$(FfmpegRoot)\README.txt" DestinationFiles="$(PublishDir)ffmpeg-README.txt"
          Condition="'$(FfmpegRoot)' != '' And Exists('$(FfmpegRoot)\README.txt')" />

    <Message Importance="high" Text="Bundled ffmpeg from $(FoundFfmpeg)"
             Condition="'$(FoundFfmpeg)' != '' And Exists('$(FoundFfmpeg)')" />
    <Warning Text="No ffmpeg.exe found to bundle - the published app will have no preview. Install one with: winget install Gyan.FFmpeg.Essentials"
             Condition="'$(FoundFfmpeg)' == '' Or !Exists('$(FoundFfmpeg)')" />
  </Target>

</Project>

