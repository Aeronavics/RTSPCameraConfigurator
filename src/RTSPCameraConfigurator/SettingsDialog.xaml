<Window x:Class="RTSPCameraConfigurator.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discovery settings"
        Height="440" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">

    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Subnets to search" FontWeight="SemiBold" FontSize="14"
                       Foreground="#1F4E79" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                       Text="One per line, as the first three octets - for example 192.168.1. This is the entire search scope: the app never looks anywhere else, so a bulk change can only reach a network listed here."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="ContinuousCheck" Content="Keep searching in the background"
                          VerticalAlignment="Center" IsChecked="True"/>
                <TextBlock Text="every" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <TextBox x:Name="IntervalBox" Width="52" Padding="4,3"
                         VerticalContentAlignment="Center" TextAlignment="Right"/>
                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="11" Margin="0,8,0,0"
                       Text="Saved to cameras.json. Comments and every other setting in that file are preserved."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OkButton" Content="Save" IsDefault="True" Click="OnSave"
                        MinWidth="90" Padding="12,5" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Padding="12,5"/>
            </StackPanel>
        </StackPanel>

        <TextBox x:Name="SubnetsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" Padding="6"/>
    </DockPanel>
</Window>
